  "bunpou": [
    {
      "id": "n4-bunpou-1",
      "pola": "～てある",
      "arti": "telah ~ dan hasilnya tetap",
      "rumus": "Verba-て + ある",
      "inti_singkat": "Menekankan hasil dari aksi yang masih terlihat. Mirip 'sudah disiapkan'.",
      "penjelasan": "窓が開けてある = jendela telah dibuka (dan masih terbuka). Beda dengan ている yang fokus pada aksi berlangsung. てある = fokus hasil.",
      "perbandingan": "ている (lagi ~ / sudah ~) vs てある (hasil masih ada): 電気がついている vs 電気がつけてある.",
      "contoh": [
        {
          "jp": "窓が開けてあります。",
          "kana": "まどが あけてあります。",
          "id": "Jendela dalam keadaan terbuka."
        },
        {
          "jp": "机の上に本が置いてあります。",
          "kana": "つくえのうえに ほんが おいてあります。",
          "id": "Buku diletakkan di atas meja."
        },
        {
          "jp": "壁にカレンダーがかけてあります。",
          "kana": "かべに カレンダーが かけてあります。",
          "id": "Kalender tergantung di dinding."
        }
      ],
      "kesalahan_umum": [
        "Tertukar ている dan てある",
        "Lupa partikel が untuk hasil"
      ],
      "level": "n4",
      "unit": "minggu-1",
      "tags": [
        "aspek"
      ]
    },
    {
      "id": "n4-bunpou-2",
      "pola": "～なければならない",
      "arti": "harus",
      "rumus": "Verba-ない + なければならない",
      "inti_singkat": "Kewajiban. Versi kasual: なきゃ / なくちゃ.",
      "penjelasan": "行かなければならない = harus pergi. Negatif? Tidak ada, untuk 'tidak harus' pakai なくてもいい.",
      "perbandingan": "なければならない (harus) vs なくてもいい (tidak harus / boleh tidak).",
      "contoh": [
        {
          "jp": "宿題をしなければならない。",
          "kana": "しゅくだいを しなければならない。",
          "id": "Harus mengerjakan PR."
        },
        {
          "jp": "早く寝なければならない。",
          "kana": "はやく ねなければならない。",
          "id": "Harus tidur cepat."
        },
        {
          "jp": "薬を飲まなければならない。",
          "kana": "くすりを のまなければならない。",
          "id": "Harus minum obat."
        }
      ],
      "kesalahan_umum": [
        "Salah bentuk ない",
        "Lupa ばならない lengkap"
      ],
      "level": "n4",
      "unit": "minggu-1",
      "tags": [
        "kewajiban"
      ]
    },
    {
      "id": "n4-bunpou-3",
      "pola": "～てもいい / ～てはいけない",
